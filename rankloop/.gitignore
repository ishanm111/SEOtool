# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Client work product: databases, generated reports, answer screenshots and the
# signed-in browser profiles. All of it is a specific business's data, and none
# of it should ever reach a repository.
data.db
data.db-*
data-v1-backup.db*
/reports/
/screenshots/
/generated/
/.chrome-profile/
/.chromium-profile/

# Snapshots taken before a destructive action. Same client data as above.
.backup-*/
