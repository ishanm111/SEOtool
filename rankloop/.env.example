# Signing key for client-portal session cookies.
# Required before anyone can sign in at /portal/login.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PORTAL_SECRET=

# Where clients reach this tool from the outside: the portal they sign in to and
# the questionnaire links at /q/<token>. Without it, links are built from the
# request host, which on a laptop is localhost — fine for you, a dead end for
# them. A tunnel URL is enough.
PUBLIC_BASE_URL=

# The address printed in portal invitations. Used for questionnaire links too
# when PUBLIC_BASE_URL is unset. Defaults to http://localhost:3000.
PORTAL_URL=

# Google Forms — turning a client questionnaire into a form they can fill in.
# Needs an OAuth client (type: Desktop app) with the Google Forms API and the
# Google Drive API enabled. The Search Console client works too: same project.
# Run `npm run forms-auth` to get the refresh token.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_FORMS_REFRESH_TOKEN=
